# PostgreSQL connection used by Prisma. Supply the environment's own credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a unique, high-entropy value for each deployment.
JWT_SECRET=replace-with-a-random-secret

# Comma-separated exact frontend origins. Local development origins are allowed outside production.
CLIENT_URL=http://localhost:5173
PORT=5000

# Optional media storage credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
